# Auth.js v5
AUTH_SECRET=   # generate: openssl rand -base64 32

# Google OAuth (create at console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres
# Use the "Transaction pooler" connection string (port 6543) for serverless
DATABASE_URL=

# Encryption key for Meta Access Tokens (AES-256-GCM)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@synclead.app

# Cron job protection — REQUIRED (generate: openssl rand -hex 32)
# Without this, /api/cron/cleanup is publicly accessible
CRON_SECRET=

# Cloudflare Turnstile — bot protection for /api/ingest/form (Mode A)
# Get site key + secret at dash.cloudflare.com → Turnstile
# If not set, bot challenge is skipped (rate limit + honeypot still active)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Meta Graph API version (used by CAPI and connection verify calls)
META_GRAPH_API_VERSION=v19.0

# Meta test event code — set in non-production environments to route test events
# to Meta's Events Manager test tool without polluting real data
META_TEST_EVENT_CODE=

# Encryption key versioning — used for AES-256-GCM key rotation on meta_connections
# Default version is 1 (uses ENCRYPTION_KEY above).
# To rotate: add ENCRYPTION_KEY_2=<new-64-hex> and set ENCRYPTION_KEY_VERSION=2.
# Old rows keep decrypting with their stored key version until re-encrypted.
ENCRYPTION_KEY_VERSION=1
# ENCRYPTION_KEY_2=   # only needed when rotating to version 2

# Meta CAPI outbox worker settings
# Maximum delivery attempts before a meta_event is dead-lettered (status=failed)
META_OUTBOX_MAX_ATTEMPTS=8

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Vercel Blob (avatares de usuario) ───────────────────────────────────────
# Generar en: Vercel Dashboard → Storage → Blob → Create Store → API tokens
# En local: ejecutar `vercel env pull` para obtenerlo automáticamente
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# ─── Meta Ads Insights — Beta interna (Prompt 18) ────────────────────────────
# Connection mode: only "internal_manual" is functional during beta.
# "external_oauth" requires Meta App Review + Business Verification (not yet approved).
META_CONNECTION_MODE=internal_manual

# Block the external OAuth flow until Meta App Review is complete.
# Change to "true" only after Meta grants the required permissions.
ENABLE_EXTERNAL_META_OAUTH=false

# Comma-separated Ad Account IDs authorized for the internal beta.
# Format: act_12345678,act_87654321  (act_ prefix optional — normalized automatically)
# Accounts can also be authorized via the Allowlist UI in Settings.
META_ALLOWED_AD_ACCOUNTS=

# Sync cron: add this URL to Vercel cron jobs (vercel.json)
# Path: /api/cron/meta-insights-sync  Method: GET  Authorization: Bearer $CRON_SECRET

# ─── Retention & privacy cron (Prompt 21) ─────────────────────────────────────
# Nullifies expired IPs and User-Agents, and erases PII for deletion requests.
# Same CRON_SECRET as other crons.
# Path: /api/cron/retention-cleanup  Method: GET  Authorization: Bearer $CRON_SECRET
# Recommended schedule: daily at 03:00 UTC

# ─── Vercel environment separation ────────────────────────────────────────────
# VERCEL_ENV is set automatically by Vercel: "production" | "preview" | "development"
# Do NOT set this manually — it is read by worker.ts to add test_event_code on preview.
# VERCEL_ENV=production   # (set automatically by Vercel, do not override)

# ─── Conversion Diagnostics (Prompt 25) ─────────────────────────────────────
# NEXT_PUBLIC_APP_URL is used to generate diagnostic collector URLs.
# Observations are retained 90 days — cleanup runs as part of retention-cleanup cron.
# No new secrets required: diagnostic tokens are public (revocable) and stored as SHA-256 hash.
# To clean expired observations, add to vercel.json cron:
#   /api/cron/retention-cleanup  (already handles observation retention)

# ─── Super Admin panel (/admin) ──────────────────────────────────────────────
# Password to access /admin — keep this secret and out of the repo.
# Generate: openssl rand -hex 20
ADMIN_SECRET=

# ─── Meta Lead Ads webhook ────────────────────────────────────────────────────
# Token you choose when configuring the webhook in Meta for Developers.
# Generate: openssl rand -hex 20
META_LEAD_ADS_VERIFY_TOKEN=
# App Secret from your Meta App (used to verify X-Hub-Signature-256 on webhook POST).
# Found in: Meta for Developers → Your App → Settings → Basic → App Secret
META_APP_SECRET=

# ─── Error monitoring (pending provider selection) ────────────────────────────
# Choose ONE of the following providers before production launch.
# Uncomment and fill in after integrating the SDK (see src/lib/monitoring.ts).
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# HIGHLIGHT_PROJECT_ID=
